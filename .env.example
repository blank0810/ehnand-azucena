# Absolute production URL with no trailing slash.
# Used at build time for canonical URLs, JSON-LD, robots, RSS, and sitemap.
SITE_URL=https://ehnand.com

# Optional Google Search Console HTML-tag verification content value.
GOOGLE_SITE_VERIFICATION=

# Turnstile public site key for the contact form widget.
# Public by design: it is rendered into the HTML. Without it the build falls
# back to Cloudflare's test key and warns. The matching secret key is a Worker
# secret, never a file: wrangler secret put TURNSTILE_SECRET_KEY
TURNSTILE_SITE_KEY=
