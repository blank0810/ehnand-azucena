---
import { render } from "astro:content"
import ProsePre from "@/components/content/ProsePre.astro"
import ProseTable from "@/components/content/ProseTable.astro"
import ProseRule from "@/components/content/ProseRule.astro"
import { absoluteUrl, PERSON_ID } from "@/config/site"
import ArticleLayout from "@/layouts/ArticleLayout.astro"
import {
  assertContentIntegrity,
  entrySlug,
  getAllArticles,
  getRelatedArticles,
  type ArticleEntry,
} from "@/lib/content"

export async function getStaticPaths() {
  const articles = await getAllArticles()
  return articles.map((article) => ({
    params: { slug: entrySlug(article.id) },
    props: { article },
  }))
}

interface Props {
  article: ArticleEntry
}

const { article } = Astro.props
await assertContentIntegrity()

const slug = entrySlug(article.id)
const canonicalPath = `/articles/${slug}`
const canonicalUrl = absoluteUrl(canonicalPath)
const relatedArticles = await getRelatedArticles(article, 3)
const { Content } = await render(article)

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": canonicalUrl + "#article",
  headline: article.data.title,
  description: article.data.summary,
  url: canonicalUrl,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": canonicalUrl,
  },
  image: absoluteUrl("/images/profile-new.jpg"),
  datePublished: article.data.date,
  dateModified: article.data.updated ?? article.data.date,
  articleSection: article.data.category,
  keywords: article.data.tags,
  author: { "@id": PERSON_ID },
  publisher: { "@id": PERSON_ID },
}

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: absoluteUrl("/"),
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Articles",
      item: absoluteUrl("/articles"),
    },
    {
      "@type": "ListItem",
      position: 3,
      name: article.data.title,
      item: canonicalUrl,
    },
  ],
}
---

<ArticleLayout
  article={article}
  canonicalPath={canonicalPath}
  schemas={[articleSchema, breadcrumbSchema]}
  relatedArticles={relatedArticles}
>
  <Content
    slot="content"
    components={{ table: ProseTable, hr: ProseRule, pre: ProsePre }}
  />
</ArticleLayout>
