---
import ArticleLibrary from "@/components/articles/ArticleLibrary.astro"
import { absoluteUrl, PERSON_ID } from "@/config/site"
import type { ArticleListItem } from "@/data/article-categories"
import BaseLayout from "@/layouts/BaseLayout.astro"
import {
  assertContentIntegrity,
  entrySlug,
  getPublishedArticles,
} from "@/lib/content"

await assertContentIntegrity()
const articles = await getPublishedArticles()
const canonicalPath = "/articles"
const canonicalUrl = absoluteUrl(canonicalPath)
const description =
  "Technical articles by Ehnand Azucena on business systems, cloud architecture, AI automation, and reliable engineering practice."

const articleItems: ArticleListItem[] = articles.map((article) => ({
  slug: entrySlug(article.id),
  title: article.data.title,
  date: article.data.date,
  updated: article.data.updated,
  summary: article.data.summary,
  category: article.data.category,
  tags: article.data.tags,
}))

const blogSchema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "@id": canonicalUrl + "#blog",
  name: "Technical Articles",
  description,
  url: canonicalUrl,
  author: { "@id": PERSON_ID },
  blogPost: articles.map((article) => {
    const url = absoluteUrl(`/articles/${entrySlug(article.id)}`)
    return {
      "@type": "BlogPosting",
      "@id": url + "#article",
      headline: article.data.title,
      description: article.data.summary,
      url,
      datePublished: article.data.date,
      dateModified: article.data.updated ?? article.data.date,
      articleSection: article.data.category,
      keywords: article.data.tags,
      author: { "@id": PERSON_ID },
    }
  }),
}

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: absoluteUrl("/"),
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Articles",
      item: canonicalUrl,
    },
  ],
}
---

<BaseLayout
  title="Technical Articles | Ehnand Azucena"
  description={description}
  canonicalPath={canonicalPath}
  schemas={[blogSchema, breadcrumbSchema]}
>
  <main id="main-content" class="articles-archive container">
    <header class="archive-intro article-archive-intro">
      <div>
        <p class="mono-label">Production notes · weekly publishing</p>
        <h1>Technical Articles</h1>
        <p>
          Field notes from building and maintaining business systems: data integrity,
          cloud delivery, AI-assisted workflows, and the reliability work between them.
        </p>
      </div>
      <div class="archive-count">
        <strong>{articles.length}</strong>
        <span>published articles</span>
      </div>
    </header>

    <ArticleLibrary articles={articleItems} />
  </main>
</BaseLayout>
