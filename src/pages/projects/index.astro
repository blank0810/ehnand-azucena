---
import ProjectRecord from "@/components/projects/ProjectRecord.astro"
import Breadcrumbs from "@/components/site/Breadcrumbs.astro"
import { absoluteUrl, PERSON_ID } from "@/config/site"
import { PROJECTS } from "@/data/projects"
import BaseLayout from "@/layouts/BaseLayout.astro"
import { assertContentIntegrity } from "@/lib/content"

await assertContentIntegrity()

const title = "Full Stack Projects | Ehnand Azucena"
const description =
  "A complete record of Ehnand Azucena's production SaaS, government, enterprise, automation, and software projects."

const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": absoluteUrl("/projects#collection"),
  url: absoluteUrl("/projects"),
  name: "Full Stack Projects",
  description,
  author: { "@id": PERSON_ID },
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: PROJECTS.length,
    itemListElement: PROJECTS.map((project, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: project.title,
      url: absoluteUrl(`/projects/${project.slug}`),
    })),
  },
}

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: absoluteUrl("/"),
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Projects",
      item: absoluteUrl("/projects"),
    },
  ],
}
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/projects"
  schemas={[collectionSchema, breadcrumbSchema]}
>
  <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Projects" }]} />
  <main id="main-content" class="projects-archive container">
    <header class="archive-intro">
      <div>
        <h1>Full stack project record</h1>
        <p>{description}</p>
      </div>
      <p class="archive-count">
        <strong>{PROJECTS.length}</strong>
        <span class="mono-label">verified project records</span>
        <span class="archive-scroll-hint">
          Scroll to browse all {PROJECTS.length} records
        </span>
      </p>
    </header>

    <section
      class="projects-register"
      data-scroll-region="projects"
      aria-label="Project records"
      tabindex="0"
    >
      {
        PROJECTS.map((project, index) => (
          <ProjectRecord project={project} index={index} priority={index === 0} />
        ))
      }
    </section>
  </main>
</BaseLayout>
