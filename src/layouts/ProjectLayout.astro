---
import Breadcrumbs from "@/components/site/Breadcrumbs.astro"
import ProjectNarrative from "@/components/content/ProjectNarrative.astro"
import type { Project } from "@/data/projects"
import BaseLayout from "@/layouts/BaseLayout.astro"
import { entrySlug, type ArticleEntry } from "@/lib/content"
import { formatIsoDate } from "@/lib/dates"
import type { NarrativeRecord } from "@/lib/project-narrative"

interface Props {
  project: Project
  canonicalPath: string
  schemas: unknown[]
  narrative: NarrativeRecord[]
  relatedArticles: ArticleEntry[]
}

const { project, canonicalPath, schemas, narrative, relatedArticles } = Astro.props
const hasCaseStudy = Astro.slots.has("case-study")
const title = `${project.title} | Ehnand Azucena`
---

<BaseLayout
  title={title}
  description={project.description}
  canonicalPath={canonicalPath}
  imagePath={project.image.src}
  schemas={schemas}
>
  <Breadcrumbs
    items={[
      { label: "Home", href: "/" },
      { label: "Projects", href: "/projects" },
      { label: project.title },
    ]}
  />
  <main id="main-content" class="project-detail container">
    <header class="project-detail__header">
      <div class="project-detail__lead">
        <p class="mono-label">{project.category}</p>
        <h1>{project.title}</h1>
        <p>{project.description}</p>
      </div>
      <dl class="project-detail__meta">
        <div><dt>Role</dt><dd>{project.role}</dd></div>
        <div><dt>Period</dt><dd>{project.period}</dd></div>
        <div><dt>Status</dt><dd>{project.status}</dd></div>
      </dl>
      {(project.liveUrl || project.githubUrl) && (
        <div class="project-detail__external">
          {project.liveUrl && (
            <a class="button button--secondary" href={project.liveUrl} target="_blank" rel="noopener noreferrer">
              Visit live site
            </a>
          )}
          {project.githubUrl && (
            <a class="button button--secondary" href={project.githubUrl} target="_blank" rel="noopener noreferrer">
              View source code
            </a>
          )}
        </div>
      )}
    </header>

    <figure class:list={["project-detail__image", { "is-fallback": project.image.fallback }]}>
      <img
        src={project.image.src}
        width={project.image.width}
        height={project.image.height}
        alt={project.image.alt}
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
      {project.image.fallback && <figcaption>This is the existing repository fallback image.</figcaption>}
    </figure>

    <div class="project-detail__content">
      <article>
        {hasCaseStudy ? (
          <div class="prose"><slot name="case-study" /></div>
        ) : (
          <ProjectNarrative records={narrative} />
        )}
      </article>

      <aside class="project-detail__stack" aria-labelledby="project-stack-title">
        <h2 id="project-stack-title">Technology record</h2>
        <ul class="technology-list">
          {project.technologies.map((technology) => <li>{technology}</li>)}
        </ul>
      </aside>
    </div>

    {relatedArticles.length > 0 && (
      <section class="project-related" aria-labelledby="project-related-title">
        <h2 id="project-related-title">Related field notes</h2>
        <div>
          {relatedArticles.map((article) => {
            const slug = entrySlug(article.id)
            return (
              <article class="record">
                <p class="mono-label">
                  {article.data.category} · <time datetime={article.data.date}>{formatIsoDate(article.data.date)}</time>
                </p>
                <h3><a href={`/articles/${slug}`}>{article.data.title}</a></h3>
                <p>{article.data.summary}</p>
              </article>
            )
          })}
        </div>
      </section>
    )}

    <nav class="project-detail__actions" aria-label="Project actions">
      <a class="button button--secondary" href="/projects">Back to all projects</a>
      <a class="button button--primary" href="/#contact">Discuss a project</a>
    </nav>
  </main>
</BaseLayout>
