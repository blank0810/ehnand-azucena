---
import type { Project } from "@/data/projects"

interface Props {
  project: Project
  priority?: boolean
  index: number
}

const { project, priority = false, index } = Astro.props
---

<article
  class="project-record record"
  data-project-record={project.slug}
  aria-labelledby={`project-${project.slug}`}
>
  <div class="project-record__index mono-label">
    {String(index + 1).padStart(2, "0")}
  </div>
  <div class:list={["project-record__image", { "is-fallback": project.image.fallback }]}>
    <img
      src={project.image.src}
      width={project.image.width}
      height={project.image.height}
      alt={project.image.alt}
      loading={priority ? "eager" : "lazy"}
      decoding="async"
      fetchpriority={priority ? "high" : "auto"}
    />
  </div>
  <div class="project-record__body">
    <p class="mono-label">{project.category} · {project.status}</p>
    <h2 id={`project-${project.slug}`}>{project.title}</h2>
    <p>{project.description}</p>
    <ul class="technology-list">
      {project.technologies.slice(0, 5).map((technology) => <li>{technology}</li>)}
    </ul>
  </div>
  <div class="project-record__aside">
    <dl>
      <div><dt>Role</dt><dd>{project.role}</dd></div>
      <div><dt>Period</dt><dd>{project.period}</dd></div>
    </dl>
    <a class="button button--secondary" href={`/projects/${project.slug}`}>
      View project record
    </a>
    {(project.liveUrl || project.githubUrl) && (
      <div class="project-record__external">
        {project.liveUrl && (
          <a href={project.liveUrl} target="_blank" rel="noopener noreferrer">Live site</a>
        )}
        {project.githubUrl && (
          <a href={project.githubUrl} target="_blank" rel="noopener noreferrer">Source code</a>
        )}
      </div>
    )}
  </div>
</article>
