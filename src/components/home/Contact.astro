---
import { PROFILE, TURNSTILE_SITE_KEY } from "@/config/site"
---

<section id="contact" class="section contact" aria-labelledby="contact-title">
  <div class="container contact__layout">
    <div>
      <h2 id="contact-title">Discuss a system that needs to ship</h2>
      <p>
        Share the operating problem, current constraints, and what production needs to
        look like.
      </p>

      <noscript>
        <p class="contact-form__noscript">
          The form below needs JavaScript. Email me directly instead — it reaches
          me the same way.
        </p>
        <a class="contact__email" href={`mailto:${PROFILE.email}`}>{PROFILE.email}</a>
      </noscript>

      <form
        class="contact-form"
        data-contact-form
        method="post"
        action="/api/contact"
      >
        <div class="contact-form__row">
          <div class="contact-form__field">
            <label for="contact-name">
              Name <span class="contact-form__optional">optional</span>
            </label>
            <input
              id="contact-name"
              name="name"
              type="text"
              maxlength="100"
              autocomplete="name"
              aria-describedby="contact-name-error"
            />
            <p class="contact-form__error" id="contact-name-error" data-field-error="name" hidden></p>
          </div>

          <div class="contact-form__field">
            <label for="contact-company">
              Company <span class="contact-form__optional">optional</span>
            </label>
            <input
              id="contact-company"
              name="company"
              type="text"
              maxlength="100"
              autocomplete="organization"
              aria-describedby="contact-company-error"
            />
            <p class="contact-form__error" id="contact-company-error" data-field-error="company" hidden></p>
          </div>
        </div>

        <div class="contact-form__field">
          <label for="contact-email">
            Email <span class="contact-form__required" aria-hidden="true">required</span>
          </label>
          <input
            id="contact-email"
            name="email"
            type="email"
            required
            maxlength="254"
            autocomplete="email"
            aria-describedby="contact-email-error"
          />
          <p class="contact-form__error" id="contact-email-error" data-field-error="email" hidden></p>
        </div>

        <div class="contact-form__field">
          <label for="contact-message">
            What needs to ship <span class="contact-form__required" aria-hidden="true">required</span>
          </label>
          <textarea
            id="contact-message"
            name="message"
            required
            rows="5"
            minlength="10"
            maxlength="4000"
            aria-describedby="contact-message-error"
          ></textarea>
          <p class="contact-form__error" id="contact-message-error" data-field-error="message" hidden></p>
        </div>

        <div class="contact-form__trap" aria-hidden="true">
          <label for="contact-website">Website</label>
          <input
            id="contact-website"
            name="website"
            type="text"
            tabindex="-1"
            autocomplete="off"
          />
        </div>

        <div
          class="cf-turnstile contact-form__challenge"
          data-sitekey={TURNSTILE_SITE_KEY}
          data-theme="dark"
          data-action="contact"
          data-contact-challenge
        >
        </div>

        <div class="contact-form__actions">
          <button class="button button--primary contact-form__submit" type="submit" data-contact-submit>
            Send message
          </button>
          <p class="contact-form__alt">
            Or email <a href={`mailto:${PROFILE.email}`}>{PROFILE.email}</a>
          </p>
        </div>

        <p
          class="contact-form__status"
          role="status"
          tabindex="-1"
          aria-live="polite"
          data-contact-status
          hidden
        >
        </p>
      </form>
    </div>

    <dl class="contact__records">
      <div>
        <dt>Availability</dt>
        <dd>{PROFILE.availability}</dd>
      </div>
      <div>
        <dt>Location</dt>
        <dd>{PROFILE.location} · {PROFILE.timezone}</dd>
      </div>
      <div>
        <dt>Direct</dt>
        <dd><a href={PROFILE.whatsappUrl} target="_blank" rel="noopener noreferrer">WhatsApp</a></dd>
      </div>
      <div>
        <dt>Professional</dt>
        <dd><a href={PROFILE.linkedinUrl} target="_blank" rel="noopener noreferrer">LinkedIn</a></dd>
      </div>
      <div>
        <dt>Code</dt>
        <dd><a href={PROFILE.githubUrl} target="_blank" rel="noopener noreferrer">GitHub</a></dd>
      </div>
      <div>
        <dt>Background</dt>
        <dd><a href={PROFILE.resumeUrl} target="_blank" rel="noopener noreferrer">Résumé</a></dd>
      </div>
    </dl>
  </div>
</section>

<script
  is:inline
  src="https://challenges.cloudflare.com/turnstile/v0/api.js"
  async
  defer></script>
<script src="../../scripts/contact-form.ts"></script>
