---
import { getProjectBySlug, PROJECTS, type Project } from "@/data/projects"

const selectedSlugs = [
  "adam-ai",
  "initao-water-billing-system",
  "repsshield",
] as const

const selected = selectedSlugs.map((slug) => getProjectBySlug(slug))
if (selected.some((project) => project === undefined)) {
  throw new Error("One or more homepage selected systems are missing")
}

const projects = selected as Project[]
---

<section id="projects" class="section selected-systems" aria-labelledby="projects-title">
  <div class="container">
    <div class="section-heading">
      <h2 id="projects-title">Selected systems</h2>
      <p>
        A focused record of production SaaS, public-service infrastructure, and
        AI-assisted compliance. Browse the complete project inventory.
      </p>
    </div>

    <div class="selected-systems__list">
      {
        projects.map((project, index) => (
          <article
            class="selected-system record"
            data-selected-system={project.slug}
            aria-labelledby={`selected-${project.slug}`}
          >
            <div class="selected-system__image">
              <img
                src={project.image.src}
                width={project.image.width}
                height={project.image.height}
                alt={project.image.alt}
                loading={index === 0 ? "eager" : "lazy"}
                decoding="async"
              />
            </div>
            <div class="selected-system__content">
              <p class="mono-label">
                {project.category} · {project.status}
              </p>
              <h3 id={`selected-${project.slug}`}>{project.title}</h3>
              <p>{project.description}</p>
              <ul class="technology-list">
                {project.technologies.slice(0, 5).map((technology) => (
                  <li>{technology}</li>
                ))}
              </ul>
            </div>
            <div class="selected-system__meta">
              <dl>
                <div><dt>Role</dt><dd>{project.role}</dd></div>
                <div><dt>Period</dt><dd>{project.period}</dd></div>
              </dl>
              <a class="text-link" href={`/projects/${project.slug}`}>View project record</a>
            </div>
          </article>
        ))
      }
    </div>
    <a class="section-link" href="/projects">Inspect all {PROJECTS.length} projects</a>
  </div>
</section>
