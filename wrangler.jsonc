{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ehnand-azucena",
	"compatibility_date": "2026-08-16",
	"workers_dev": false,
	"observability": {
		"enabled": true,
	},
	"assets": {
		"directory": "./dist",
		"html_handling": "drop-trailing-slash",
		"not_found_handling": "404-page",
	},
}
