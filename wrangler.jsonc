{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ehnand-azucena",
	"main": "worker/index.ts",
	"compatibility_date": "2026-08-16",
	"workers_dev": false,
	"observability": {
		"enabled": true,
	},
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"html_handling": "drop-trailing-slash",
		"not_found_handling": "404-page",
		// Static assets ignore Range, and Safari needs 206 responses to play
		// video, so the article clips go through the Worker (worker/video.ts).
		// With a pattern list, unlisted paths never reach the Worker, so the
		// contact endpoint is listed too. Only these requests count against the
		// Workers request limit; every other asset stays free. Workers Caching
		// is deliberately not enabled: it would bill every static asset request.
		"run_worker_first": ["/api/*", "/videos/*"],
	},
	// Recipient is pinned at the binding: even if every other check were
	// defeated, this Worker cannot address a third party.
	"send_email": [
		{
			"name": "EMAIL",
			"destination_address": "contact@ehnand.com",
		},
	],
	"ratelimits": [
		{
			"name": "CONTACT_RATE_LIMIT",
			"namespace_id": "1001",
			"simple": {
				"limit": 5,
				"period": 60,
			},
		},
	],
	"vars": {
		"CONTACT_TO": "contact@ehnand.com",
		"CONTACT_FROM": "form@ehnand.com",
		"CONTACT_DRY_RUN": "false",
	},
}
